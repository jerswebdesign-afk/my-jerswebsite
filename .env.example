# Copy this file to .env for local development. Never commit the real .env file.
# These are read only by server-side code in /api — Vite never bundles them
# into the frontend because they are not prefixed with VITE_.

# Stripe Dashboard -> Developers -> API keys (secret key)
STRIPE_SECRET_KEY=sk_live_or_test_xxx

# Stripe Dashboard -> Developers -> Webhooks -> your endpoint -> Signing secret
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Supabase project URL (Project Settings -> API)
SUPABASE_URL=https://lemhapjrfnxfmtwhkcat.supabase.co

# Supabase server-side key (Project Settings -> API Keys) - server-side only, never expose to the client.
# Accepts either the legacy service_role JWT (eyJ...) or the newer secret key
# (sb_secret_...) - both work with createClient() unchanged, so you can
# rotate to the new key format whenever without touching code.
SUPABASE_SERVICE_ROLE_KEY=xxx

# --- Owner/dev bypass (src/supabaseClient.js) ---
# VITE_-prefixed vars ARE bundled into the frontend, unlike the ones above.
# That's fine here: these are the public anon/publishable key, which cannot
# read any table (purchases, admins, etc. all have RLS enabled with no
# policies) - it can only run Supabase Auth sign-in for the owner/dev login
# at /owner-login. The actual bypass decision always happens server-side in
# api/check-owner.js against public.admins.
VITE_SUPABASE_URL=https://lemhapjrfnxfmtwhkcat.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_XgVqD0ZIxEqjxxrh0b8lNg_xqlMl90q
